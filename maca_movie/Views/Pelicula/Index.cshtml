@model IEnumerable<maca_movie.Models.Pelicula>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css" />

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table id="tablaPeliculas" class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            
            <th>
                Duración
            </th>
            
            <th>
                Imagen
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Genero)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Plataforma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PromedioRating)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
       
            <td>
                @Html.DisplayFor(model => item.MinutosDuracion)
            </td>
          
            <td>
                <img src="@item.PosterUrl" height="50px"\>
            </td>
          
            <td>
                @Html.DisplayFor(Model => item.Genero.Descripcion)
                  
            </td>
         
            <td>
                @Html.DisplayFor(Model => item.Plataforma.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.PromedioRating)
            </td>
         
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.min.js"></script>
    <script>
        new DataTable('#tablaPeliculas', {
            lengthMenu: [5, 10, 25, 50, 100],
            language: {
                search: 'Buscar:',
                lengthMenu: 'Mostrar _MENU_ películas',
                info: 'Mostrando _START_ a _END_ de _TOTAL_ películas',
                infoEmpty: 'No hay películas para mostrar',
                zeroRecords: 'No se encontraron películas',
                emptyTable: 'No hay películas disponibles',
                paginate: {
                    first: 'Primera',
                    last: 'Última',
                    next: 'Siguiente',
                    previous: 'Anterior'
                }
            }
        });
    </script>
}
